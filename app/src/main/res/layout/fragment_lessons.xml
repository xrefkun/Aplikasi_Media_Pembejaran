<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8F9FA"
        tools:context=".LessonsFragment">

        <!-- Header & Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Materi Belajar"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih topik untuk memperdalam keahlian pemrograman Android Anda"
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- Search Bar -->
            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Cari materi..."
                android:singleLine="true"
                android:background="@drawable/edittext_bg"
                android:backgroundTint="#F1F3F5"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Horizontal Category Filter -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layoutCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Semua"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/gradient_button"
                    android:backgroundTint="@null"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tabKotlin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Biologi"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:background="@drawable/edittext_bg"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tabAndroid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fisika"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:background="@drawable/edittext_bg"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tabStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kimia"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:background="@drawable/edittext_bg"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tabNetwork"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Networking"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:background="@drawable/edittext_bg"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- RecyclerView for Lessons List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLessons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_lesson" />

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddLesson"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        android:backgroundTint="#2196F3"
        android:visibility="gone"
        tools:visibility="visible"
        android:contentDescription="Tambah Materi" />

</FrameLayout>

